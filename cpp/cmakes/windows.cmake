# 设置运行库。
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
if (CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDebug)
endif ()
if (COMPILE_DYNAMIC_MODE)
    set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
    if (CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDebugDLL)
    endif ()
endif ()

# 设置依赖库的编译参数。
set(LIBRARY_COMPILE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
set(LIBRARY_COMPILE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} /MTd")
set(LIBRARY_COMPILE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} /MT")
set(LIBRARY_COMPILE_C_FLAGS "${CMAKE_C_FLAGS}")
set(LIBRARY_COMPILE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG} /MTd")
set(LIBRARY_COMPILE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} /MT")
if (COMPILE_DYNAMIC_MODE)
    set(LIBRARY_COMPILE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
    set(LIBRARY_COMPILE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} /MDd")
    set(LIBRARY_COMPILE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} /MD")
    set(LIBRARY_COMPILE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG} /MDd")
    set(LIBRARY_COMPILE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} /MD")
endif ()

# 设置编译参数。
# MT：静态链接运行时库（Release 模式）。
# MTd：静态链接运行时库（Debug 模式）。
# MD：动态链接运行时库（Release 模式）。
# MDd：动态链接运行时库（Debug 模式）。
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /utf-8")
set(TMP_CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} /MTd")
set(TMP_CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} /MT")
if (COMPILE_DYNAMIC_MODE)
    set(TMP_CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} /MDd")
    set(TMP_CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} /MD")
endif ()
set(CMAKE_CXX_FLAGS_DEBUG "${TMP_CMAKE_CXX_FLAGS_DEBUG}")
set(CMAKE_CXX_FLAGS_RELEASE "${TMP_CMAKE_CXX_FLAGS_RELEASE}")
unset(TMP_CMAKE_CXX_FLAGS_DEBUG)
unset(TMP_CMAKE_CXX_FLAGS_RELEASE)

# 添加依赖。
string(TOLOWER "${CMAKE_BUILD_TYPE}" TMP_BUILD_TYPE)
set(TMP_LINK_TYPE static)
if (COMPILE_DYNAMIC_MODE)
    set(TMP_LINK_TYPE dynamic)
endif ()
include(${CMAKE_SOURCE_DIR}/cmakes/windows/argparse/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/bzip2/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/cpp-httplib/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/pugixml/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/xz/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/yaml-cpp/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/zlib/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/zstd/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/openssl/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/jwt-cpp/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/windows/libzip/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
unset(TMP_BUILD_TYPE)
unset(TMP_LINK_TYPE)

list(APPEND DEFINITIONS "-DWINDOWS")

unset(LIBRARY_COMPILE_CXX_FLAGS)
unset(LIBRARY_COMPILE_CXX_FLAGS_DEBUG)
unset(LIBRARY_COMPILE_CXX_FLAGS_RELEASE)
unset(LIBRARY_COMPILE_C_FLAGS)
unset(LIBRARY_COMPILE_C_FLAGS_DEBUG)
unset(LIBRARY_COMPILE_C_FLAGS_RELEASE)
