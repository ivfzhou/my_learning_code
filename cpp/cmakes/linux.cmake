# 设置依赖库的编译参数。
set(LIBRARY_COMPILE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
set(LIBRARY_COMPILE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -D_GLIBCXX_DEBUG")
set(LIBRARY_COMPILE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE}")
set(LIBRARY_COMPILE_C_FLAGS "${CMAKE_C_FLAGS}")
set(LIBRARY_COMPILE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG} -D_GLIBCXX_DEBUG")
set(LIBRARY_COMPILE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE}")
if (COMPILE_DYNAMIC_MODE)
    set(LIBRARY_COMPILE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
    set(LIBRARY_COMPILE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -D_GLIBCXX_DEBUG")
    set(LIBRARY_COMPILE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE}")
    set(LIBRARY_COMPILE_C_FLAGS "${CMAKE_C_FLAGS}")
    set(LIBRARY_COMPILE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG} -D_GLIBCXX_DEBUG")
    set(LIBRARY_COMPILE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE}")
endif ()

# 设置编译参数。
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -finput-charset=UTF-8 -fexec-charset=UTF-8")
set(TMP_CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} --all-warnings -pedantic -Winline -O0 -Wall -g3 -D_GLIBCXX_DEBUG -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function")
set(TMP_CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3 -g0")
if (COMPILE_DYNAMIC_MODE)
    set(TMP_CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} --all-warnings -pedantic -Winline -O0 -Wall -g3 -D_GLIBCXX_DEBUG -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function")
    set(TMP_CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3 -g0")
endif ()
set(CMAKE_CXX_FLAGS_DEBUG "${TMP_CMAKE_CXX_FLAGS_DEBUG}")
set(CMAKE_CXX_FLAGS_RELEASE "${TMP_CMAKE_CXX_FLAGS_RELEASE}")
unset(TMP_CMAKE_CXX_FLAGS_DEBUG)
unset(TMP_CMAKE_CXX_FLAGS_RELEASE)

# 添加依赖。
string(TOLOWER "${CMAKE_BUILD_TYPE}" TMP_BUILD_TYPE)
set(TMP_LINK_TYPE static)
if (COMPILE_DYNAMIC_MODE)
    set(TMP_LINK_TYPE dynamic)
endif ()
include(${CMAKE_SOURCE_DIR}/cmakes/linux/argparse/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/bzip2/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/cpp-httplib/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/pugixml/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/xz/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/yaml-cpp/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/zlib/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/zstd/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/openssl/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/jwt-cpp/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
include(${CMAKE_SOURCE_DIR}/cmakes/linux/libzip/${TMP_BUILD_TYPE}_${TMP_LINK_TYPE}.cmake)
unset(TMP_BUILD_TYPE)
unset(TMP_LINK_TYPE)

list(APPEND DEFINITIONS "-DLINUX")

unset(LIBRARY_COMPILE_CXX_FLAGS)
unset(LIBRARY_COMPILE_CXX_FLAGS_DEBUG)
unset(LIBRARY_COMPILE_CXX_FLAGS_RELEASE)
unset(LIBRARY_COMPILE_C_FLAGS)
unset(LIBRARY_COMPILE_C_FLAGS_DEBUG)
unset(LIBRARY_COMPILE_C_FLAGS_RELEASE)
